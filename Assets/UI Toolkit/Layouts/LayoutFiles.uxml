<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Layouts/Style.uss?fileID=7433441132597879392&amp;guid=d226f2eefd6d2c44b97ce051a3f93028&amp;type=3#Style" />
    <ui:VisualElement name="Container" class="card" style="flex-grow: 0; background-color: rgb(236, 236, 236); margin-top: 0; margin-bottom: 0; align-items: flex-start; width: 20%; margin-left: 0; margin-right: 0; display: flex; height: 40%;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); width: 100%; height: 20%;" />
        <ui:Button text="Create New Project" display-tooltip-when-elided="true" name="buttonNew" class="text-pick btn" />
        <ui:Button text="Save Project..." display-tooltip-when-elided="true" name="buttonSave" class="text-pick btn" />
        <ui:Button text="Load Project..." display-tooltip-when-elided="true" name="buttonLoad" class="text-pick btn" />
        <ui:Button text="Generate Instructions" display-tooltip-when-elided="true" name="buttonGenerate" class="text-pick btn" />
    </ui:VisualElement>
</ui:UXML>
