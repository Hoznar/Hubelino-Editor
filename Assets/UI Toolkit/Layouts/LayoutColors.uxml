<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Layouts/Style.uss?fileID=7433441132597879392&amp;guid=d226f2eefd6d2c44b97ce051a3f93028&amp;type=3#Style" />
    <ui:VisualElement name="Container" class="card" style="flex-grow: 0; background-color: rgb(236, 236, 236); width: 15%; height: auto; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; align-items: auto; flex-direction: column; border-top-left-radius: 0; border-bottom-left-radius: 10px; border-top-right-radius: 0; border-bottom-right-radius: 10px;">
        <ui:VisualElement name="ItemsColors" class="labeled-container" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: auto;">
            <ui:Label tabindex="-1" text="Colors" display-tooltip-when-elided="true" name="Colors" class="small-text" />
            <ui:VisualElement name="ColorsList" class="button-items" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); justify-content: flex-start; align-self: stretch; align-items: center;">
                <ui:Button text="&#10;" display-tooltip-when-elided="true" name="Red" class="button btn" style="border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); background-color: rgb(212, 43, 43); border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; padding-left: 8%; padding-right: 8%; padding-top: 8%; padding-bottom: 8%; margin-bottom: 10px;" />
                <ui:Button text="&#10;" display-tooltip-when-elided="true" name="Blue" class="button btn" style="width: auto; height: auto; border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); background-color: rgb(35, 65, 145); padding-left: 8%; padding-right: 8%; padding-top: 8%; padding-bottom: 8%; margin-bottom: 10px;" />
                <ui:Button text="&#10;" display-tooltip-when-elided="true" name="Green" class="button btn" style="width: auto; height: auto; border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); background-color: rgb(45, 139, 63); padding-left: 8%; padding-right: 8%; padding-top: 8%; padding-bottom: 8%; margin-bottom: 10px;" />
                <ui:Button text="&#10;" display-tooltip-when-elided="true" name="Yellow" class="button btn" style="width: auto; height: auto; border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); background-color: rgb(240, 199, 0); padding-left: 8%; padding-right: 8%; padding-top: 8%; padding-bottom: 8%; margin-bottom: 10px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
