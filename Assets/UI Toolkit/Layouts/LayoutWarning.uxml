<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Layouts/Style.uss?fileID=7433441132597879392&amp;guid=d226f2eefd6d2c44b97ce051a3f93028&amp;type=3#Style" />
    <ui:VisualElement name="WarningBox" class="card" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); display: none; margin-left: auto; margin-right: 3%; margin-top: auto; margin-bottom: 1%; width: 20%; height: auto; align-items: flex-end; translate: 0 0;">
        <ui:VisualElement name="Warning" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); background-image: resource(&apos;Icons/icon_warning&apos;); padding-left: 10%; padding-right: 10%; padding-top: 10%; padding-bottom: 10%;" />
        <ui:Label tabindex="-1" text="Build height is above limit. &#10;Instructions won&apos;t be complete." display-tooltip-when-elided="true" name="WarningText" class="small-text" style="display: flex; -unity-text-align: upper-right; background-color: rgb(224, 73, 73); color: rgb(255, 255, 255); padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; opacity: 1;" />
    </ui:VisualElement>
</ui:UXML>
