.button {
    flex-shrink: 0;
    width: auto;
    height: auto;
    margin-left: 3%;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 8%;
    padding-right: 8%;
    padding-top: 8%;
    padding-bottom: 8%;
    background-color: rgb(195, 195, 195);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 50%;
    border-bottom-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-elastic;
    justify-content: flex-start;
}

.button:hover {
    scale: 1.2 1.2;
}

.btn {
}

.button-icon {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    width: auto;
    height: auto;
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    margin-left: auto;
    align-self: center;
    margin-right: auto;
    margin-top: auto;
    margin-bottom: auto;
    padding-left: 4%;
    padding-right: 4%;
    padding-top: 4%;
    padding-bottom: 4%;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-elastic;
}

.button-icon:hover {
    width: auto;
    height: auto;
    scale: 1.2 1.2;
}

.labeled-container {
    flex-grow: 0;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: column;
    align-items: flex-start;
    flex-wrap: nowrap;
    align-self: flex-start;
    width: 100%;
    height: 20%;
    border-top-color: rgb(180, 180, 180);
    flex-shrink: 1;
}

.small-text {
    margin-left: 10px;
    -unity-font-style: bold;
    font-size: 15px;
    margin-top: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.button-items {
    align-items: center;
    align-self: stretch;
    flex-direction: row;
    justify-content: flex-start;
    flex-grow: 0;
}

.card {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.94);
    margin-left: auto;
    margin-right: auto;
    margin-top: 255px;
    margin-bottom: 255px;
    width: 375px;
    height: 0;
    align-items: auto;
    justify-content: flex-start;
    align-self: auto;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    flex-direction: column;
    translate: 0 -100%;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

.card-active {
    translate: 0 0;
}

.button-counter {
    width: 5%;
    height: 5%;
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    background-image: url('project://database/Assets/UnityDefaultRuntimeTheme.tss?fileID=-3753015318093942961&guid=288b8f5355d8f3147823d38a9f396660&type=3#arrow-left');
}

.item {
    background-color: rgb(236, 236, 237);
    width: 95%;
    height: 75px;
    align-self: center;
    flex-grow: 1;
    margin-top: 2%;
    flex-direction: row;
}

.text-pick {
    width: 95%;
    height: 19%;
    margin-left: 2%;
    -unity-font-style: bold;
    border-bottom-color: rgba(212, 212, 212, 0);
    border-left-color: rgba(212, 212, 212, 0);
    border-right-color: rgba(212, 212, 212, 0);
    border-top-color: rgb(212, 212, 212);
    border-top-width: 1px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(27, 27, 27);
    -unity-text-align: middle-left;
}

.text-pick:hover {
    background-color: rgb(219, 219, 219);
    transform-origin: center;
}

.block-icon {
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
}

.unity-toggle__checkmark {
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    margin-left: 3px;
}

.unity-popup-field__input {
    background-color: white;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-width: 2px;
}

.button-big {
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    background-color: rgb(221, 68, 68);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    align-self: center;
    width: 100%;
}
