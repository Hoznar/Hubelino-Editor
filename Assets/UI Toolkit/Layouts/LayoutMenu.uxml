<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Layouts/Style.uss?fileID=7433441132597879392&amp;guid=d226f2eefd6d2c44b97ce051a3f93028&amp;type=3#Style" />
    <ui:VisualElement name="Container" class="card" style="flex-grow: 0; background-color: rgb(236, 236, 236); width: 30%; margin-left: auto; margin-right: auto; margin-top: auto; margin-bottom: auto; height: auto; translate: 0 0;">
        <ui:VisualElement name="Menu" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); width: 90%; align-self: center;">
            <ui:VisualElement name="infoContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row;">
                <ui:Label tabindex="-1" text="Create Project&#10;" display-tooltip-when-elided="true" name="labelProject" class="small-text" style="font-size: 20px; margin-top: 4%; margin-left: 0; margin-right: 0; margin-bottom: 0; width: 95%;" />
                <ui:Button display-tooltip-when-elided="true" name="buttonClose" class="button-icon" style="width: 5%; background-color: rgba(188, 188, 188, 0); background-image: resource(&apos;Icons/icon_close&apos;); -unity-background-scale-mode: scale-to-fit; scale: 0.5 0.5; display: none;" />
            </ui:VisualElement>
            <ui:TextField picking-mode="Ignore" label="Name" value="My custom build" max-length="20" name="setterName" style="align-items: center; font-size: 20px;" />
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center;">
                <ui:SliderInt picking-mode="Ignore" label="Board Length" value="6" high-value="12" low-value="6" show-input-field="false" name="setterLength" style="font-size: 20px; align-items: center; width: 90%;" />
                <ui:Label tabindex="-1" text="12" display-tooltip-when-elided="true" name="labelLength" class="small-text" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center;">
                <ui:SliderInt picking-mode="Ignore" label="Board Width" value="6" high-value="12" low-value="6" show-input-field="false" direction="Horizontal" inverted="false" name="setterWidth" style="font-size: 20px; align-items: center; width: 90%;" />
                <ui:Label tabindex="-1" text="12" display-tooltip-when-elided="true" name="labelWidth" class="small-text" />
            </ui:VisualElement>
            <ui:VisualElement name="buttonsContainer" style="justify-content: space-around; flex-direction: row;">
                <ui:Button text="Create Project" display-tooltip-when-elided="true" name="buttonCreateProject" class="button-big" style="margin-top: 5%; background-color: rgb(102, 173, 103); font-size: 20px; margin-bottom: 5%; width: 45%;" />
                <ui:Button text="Load Project" display-tooltip-when-elided="true" name="buttonLoadProject" class="button-big" style="width: 45%; font-size: 20px; background-color: rgb(171, 171, 171);" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
