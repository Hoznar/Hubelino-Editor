    <ui:Template name="LayoutMenu" src="project://database/Assets/UI%20Toolkit/Layouts/LayoutMenu.uxml?fileID=9197481963319205126&amp;guid=e746e593398e64a449feb0d319439811&amp;type=3#LayoutMenu" />
